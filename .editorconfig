# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.swift]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,xcstrings}]
indent_size = 2

[*.md]
indent_size = 2
# 行末の空白2つは Markdown の改行なので消さない
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
